# =============================================================================
# .env.example — MIS Core Stand-Alone
# Copie para .env e ajuste os valores. Nunca commite o .env real.
#   cp .env.example .env
# =============================================================================

# ---------------------------------------------------------------------------
# DJANGO
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=troque-este-segredo-longo-e-aleatorio-em-producao
DJANGO_DEBUG=True
# Em produção: DJANGO_ALLOWED_HOSTS=meuservidor.com,www.meuservidor.com
DJANGO_ALLOWED_HOSTS=*

# Superusuário criado automaticamente na primeira inicialização
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin123

# CSRF — lista separada por vírgula das origens permitidas
# Em produção substituir pelo domínio real: https://meuapp.com
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# CORS — origens permitidas para chamadas AJAX (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL_ORIGINS=False

# Domínio do cookie de sessão (deixar vazio para localhost / IP fixo)
SESSION_COOKIE_DOMAIN=

# JWT — se não definido herda DJANGO_SECRET_KEY; defina um valor diferente em prod
JWT_SECRET_KEY=troque-este-segredo-longo-e-aleatorio-em-producao

# ---------------------------------------------------------------------------
# MYSQL
# ---------------------------------------------------------------------------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=mis_core_db
MYSQL_DATABASE=mis_core_db
MYSQL_USER=mis
MYSQL_PASSWORD=mis123
MYSQL_ROOT_PASSWORD=root123

# ---------------------------------------------------------------------------
# INFLUXDB
# ---------------------------------------------------------------------------
INFLUXDB_HOST=influxdb
INFLUXDB_PORT=8086
INFLUXDB_DATABASE=industrial_db
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=admin123

# ---------------------------------------------------------------------------
# FASTAPI v2
# ---------------------------------------------------------------------------
FASTAPI_ENVIRONMENT=dev
FASTAPI_DEBUG=true
FASTAPI_LOG_LEVEL=INFO
# CORS para o FastAPI (JSON array)
FASTAPI_CORS_ORIGINS=["http://localhost:8080","http://localhost:5173","http://frontend"]
# Limites de payload
MAX_POINTS_PER_RESPONSE=10000
MAX_CORRELATION_VARIABLES=25
PROMETHEUS_ENABLED=true

# Senha inicial do administrador nativo do Portainer.
# Usada somente para criar a conta admin em um volume novo.
PORTAINER_ADMIN_PASSWORD=troque-por-uma-senha-forte-portainer

# ---------------------------------------------------------------------------
# FLASK (legado)
# ---------------------------------------------------------------------------
FLASK_ENV=production

# ---------------------------------------------------------------------------
# COLETOR OPC UA
# ---------------------------------------------------------------------------
INTERVALO_COLETA=2
TIMEOUT_REQUEST=10

# ---------------------------------------------------------------------------
# REDE / PORTAS EXTERNAS
# ---------------------------------------------------------------------------
# Porta pública do frontend (nginx)
FRONTEND_PORT=8080
