# InfluxDB 1.8
INFLUXDB_HOST=localhost
INFLUXDB_PORT=8086
INFLUXDB_DATABASE=industrial_db
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=admin123

# PostgreSQL
POSTGRES_DB=django_industrial
POSTGRES_USER=django_user
POSTGRES_PASSWORD=django_pass123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=django-insecure-dev-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# APIs
DJANGO_API_URL=http://localhost:8000/api
FLASK_API_URL=http://localhost:5000/api
REACT_APP_FLASK_API_URL=http://localhost:5000/api
REACT_APP_DJANGO_API_URL=http://localhost:8000/api
