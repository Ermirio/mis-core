# mis-core FastAPI v2 — variáveis de ambiente
# Copie para `.env` e ajuste localmente. Nunca comite o .env real.

# ---- App ----
APP_NAME=mis-core-api
ENVIRONMENT=development
DEBUG=false
API_V2_PREFIX=/api/v2
LOG_LEVEL=INFO

# ---- CORS (lista separada por vírgula) ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- InfluxDB 1.x ----
INFLUX_HOST=localhost
INFLUX_PORT=8086
INFLUX_DATABASE=mis_core
INFLUX_USERNAME=
INFLUX_PASSWORD=

# ---- Integração com Django (legado) / Flask ----
DJANGO_API_URL=http://localhost:8001
FLASK_API_URL=http://localhost:5000

# ---- Postgres (metadados) ----
PG_DSN=postgresql+asyncpg://mis:mis@localhost:5432/mis_core

# ---- JWT (compartilhado com Django) ----
JWT_SECRET=troque-este-segredo-em-producao
JWT_ALGORITHM=HS256

# ---- Observabilidade ----
PROMETHEUS_ENABLED=true

# ---- Guardas de payload ----
MAX_POINTS_PER_RESPONSE=20000
MAX_CORRELATION_VARIABLES=25
