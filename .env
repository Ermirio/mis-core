# ================================
# TIMEZONE
# ================================
TZ=America/Sao_Paulo


# ================================
# MYSQL (Docker - INTERNO)
# ================================
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Nome do banco (padrao do container mysql)
MYSQL_DATABASE=mis_core_db

# (compat) se seu Django usa MYSQL_DB
MYSQL_DB=mis_core_db

MYSQL_USER=mis2
MYSQL_PASSWORD=mis123
MYSQL_ROOT_PASSWORD=root123
MYSQL_ROOT_HOST=%


# ================================
# INFLUXDB 1.8 (INTERNO)
# ================================
INFLUXDB_HOST=influxdb
INFLUXDB_PORT=8086
INFLUXDB_DATABASE=mis_core_db
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=admin123

# (se você realmente usa auth via env no compose)
INFLUXDB_HTTP_AUTH_ENABLED=true

# (compat) nomes que seu compose antigo usava
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=admin123


# ================================
# DJANGO
# ================================
DJANGO_SECRET_KEY=django-insecure-dev-key-change-in-production
JWT_SECRET_KEY=django-insecure-dev-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,192.168.15.19,192.168.15.20,192.168.70.166,192.168.30.71,django
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.15.19:3000,http://192.168.15.20:3000,http://192.168.70.166:3000,http://192.168.30.71:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.15.19:3000,http://192.168.15.20:3000,http://192.168.70.166:3000,http://192.168.30.71:3000
CORS_ALLOW_ALL_ORIGINS=True

# Superuser (se seu entrypoint cria automaticamente; se não usa, pode deixar vazio)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin123


# ================================
# FLASK / APIs (interno entre containers)
# ================================
DJANGO_API_URL=http://django:8000/api


# ================================
# COLETOR OPC UA
# ================================
INTERVALO_COLETA=2
TIMEOUT_REQUEST=10


# ================================
# PORTAS NO HOST (WINDOWS)
# ================================
MYSQL_HOST_PORT=3308
INFLUXDB_HOST_PORT=8087
DJANGO_HOST_PORT=8001
FLASK_HOST_PORT=5002
FRONTEND_HOST_PORT=81
PROXY_HOST_PORT=3000


# ================================
# MIS CHANGE OVER
# ================================
MIS_CHANGEOVER_BACKEND_PORT=5006
MIS_CHANGEOVER_FRONTEND_PORT=3009


# ================================
# FRONTEND (VITE) - URLs públicas (HOST)
# ================================
VITE_DJANGO_API_URL=/mis-core-api
VITE_FLASK_API_URL=/mis-core-flask-api

VITE_APP_LOGO=/favicon.png
VITE_APP_TITLE=MIS Core
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=


# ================================
# MIS-AI (PREDICTION)
# ================================
OPC_SERVER_URL=opc.tcp://192.168.15.189:49320


# ================================
# WORKFLOW AUTOMATION (n8n)
# ================================
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=mis_admin_123
N8N_HOST_PORT=5678


# ================================
# CONTAINER MANAGEMENT (Portainer)
# ================================
PORTAINER_HOST_PORT=9000
