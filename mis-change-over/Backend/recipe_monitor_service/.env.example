# Django (mis-change-over) — base para chamadas REST
DJANGO_BASE_URL=http://localhost:8000

# Redis — cache de estado + pub/sub para WebSocket
REDIS_URL=redis://localhost:6379/0

# Cache TTL da configuração OPC vinda do Django (segundos)
OPC_CONFIG_TTL_SECONDS=60

# Subscription OPC UA — intervalo de publicação (ms)
OPC_SUBSCRIPTION_INTERVAL_MS=500

# Tamanho do histórico circular por variável (para sparkline)
HISTORY_MAX_POINTS=60

# Reconnect backoff (segundos)
OPC_RECONNECT_BACKOFF_MIN=2
OPC_RECONNECT_BACKOFF_MAX=30

# Linhas a monitorar ao iniciar (vazio = monitora sob demanda, quando primeiro WS conecta)
LINES_PRELOAD=

# Logging
LOG_LEVEL=INFO

# CORS — domínios do frontend autorizados (separados por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
