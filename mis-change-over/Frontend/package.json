  "description": "Sistema Industrial - Frontend React para Troca Automática de SKU",
  "private": true,
  "dependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.13.1",
    "bootstrap": "^5.3.0",
