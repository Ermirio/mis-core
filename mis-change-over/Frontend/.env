# .env (ou .env.production) - na raiz do seu projeto React
#
# --- ARQUIVO REVISADO PARA USAR O PROXY (01-Proxy) ---
#
# As URLs absolutas (com http://IP:PORTA) foram removidas.
# Agora, a aplicação React fará todas as chamadas para si mesma (porta 80),
# e o Nginx Proxy (01-Proxy) irá redirecionar cada requisição 
# para o serviço correto.

# --- Configurações da API ---

# 1. API Principal (Django - Backend MIS)
# Todas as chamadas para o backend principal do Django agora usam a rota /api/
# O Proxy (01-Proxy) irá direcionar /api/* para a porta 8000.
REACT_APP_SIDEBAR_API_BASE_URL=/mis-change-over-api
REACT_APP_TROCA_AUTOMATICA_BASE_URL=/mis-change-over-api

# 2. API de Dados (Density/Flask) - SOLUÇÃO DO CONFLITO
# Esta API foi movida para a rota /data-api/ para não conflitar com o Django.
# O Proxy (01-Proxy) irá direcionar /data-api/* para a porta 5002.
REACT_APP_DATA_API_ENDPOINT=/mis-change-over-data-api
REACT_APP_DATA_API_TIMEOUT=20000

# 3. API do LLM (Llama)
# O MachineChat.js adiciona /v1/... ao endpoint.
# Apontar para / faz com que a chamada seja /v1/...,
# que o Proxy (01-Proxy) irá direcionar para a porta 8080.
REACT_APP_LLAMA_ENDPOINT=/
REACT_APP_LLAMA_TIMEOUT=540000

# --- Endpoints Relativos (Estes estão corretos e não mudam) ---
# O React irá anexar estes paths às URLs base acima.
REACT_APP_SYNC_SKUS_ENDPOINT=/sincronizar-skus/
REACT_APP_HISTORICO_TROCAS_ENDPOINT=/mis-change-over-api/linha/{line}
REACT_APP_TROCAR_SKU_ENDPOINT=/trocar_sku/
REACT_APP_DJANGO_HEALTH_CHECK_INTERVAL=30000
REACT_APP_DJANGO_HEALTH_CHECK_TIMEOUT=15000
REACT_APP_DEFAULT_PAGE_SIZE=10
REACT_APP_POST_TROCA_RELOAD_DELAY=1000

# --- Outras Configurações Globais (Não mudam) ---
REACT_APP_AI_NAME=LIIA
REACT_APP_DEFAULT_LINE=L01
REACT_APP_TOAST_DURATION=5000