# Variáveis de ambiente do Frontend React (mis-change-over).
# Renomeie para .env e ajuste para o seu ambiente.

# ── Django REST API ──────────────────────────────────────────────────
# Base URL do Django. Em dev, deixe vazio e use o proxy do package.json
# ("proxy": "http://localhost:8000"). Em produção, configure aqui.
REACT_APP_SIDEBAR_API_BASE_URL=http://localhost:8000/api

# ── Recipe Monitor Service (mis-recipe-intelligent) ──────────────────
# URL base do serviço Python/FastAPI que faz a leitura OPC.
# Em dev local:  http://localhost:8100
# Em produção:   https://mis-host/recipe-monitor  (atrás do proxy reverso)
REACT_APP_RECIPE_MONITOR_URL=http://localhost:8100
