# Configurações do Backend Flask - Predição Genérica
# Este arquivo é usado no ambiente Docker

# ==================== BANCO DE DADOS ====================
# MySQL rodando no host (mesma instância do MIS)
# Porta 3307 (mapeada do container MySQL)
DATABASE_URL=mysql+pymysql://root:ixvq10A%4010@host.docker.internal:3307/density_db

# ==================== OPC UA ====================
# Servidor OPC UA
# IMPORTANTE: Altere este endereço conforme o servidor OPC na rede
# Exemplo: opc.tcp://192.168.15.189:49320 (servidor na rede)
# Exemplo: opc.tcp://host.docker.internal:49320 (servidor no host)
# OPC_SERVER_URL=opc.tcp://192.168.15.13:49320

OPC_SERVER_URL=opc.tcp://host.docker.internal:49320
# ==================== FLASK ====================
FLASK_ENV=production
FLASK_DEBUG=False

# ==================== OBSERVAÇÕES ====================
# 1. DATABASE_URL: Usa host.docker.internal para acessar MySQL no host
# 2. OPC_SERVER_URL: Altere o IP conforme o servidor OPC na sua rede
# 3. Para desenvolvimento local, use .env (sem .docker)

