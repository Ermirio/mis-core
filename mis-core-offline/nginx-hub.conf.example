# =============================================================================
# nginx-hub.conf.example
# Trecho para colar no nginx do HUB (proxy reverso pai) que controla várias
# aplicações da rede OT. O MIS Core fica acessível em https://hub/mis-core/.
#
# Premissa:
#   - mis-core-frontend escuta em 127.0.0.1:8080 (mapeado pelo compose)
#   - O hub termina TLS e fala HTTP com o backend interno
#
# Pontos críticos (cuidado quando adaptar):
#   - NÃO cachear /mis-core/index.html (usa Cache-Control de origem)
#   - Passar X-Forwarded-* para o Django reconstruir URLs absolutas
#   - WebSocket / SSE: Upgrade + Connection (necessário quando ligar /api/v2/ws/*)
# =============================================================================

# Upstream do MIS Core (frontend nginx que já tem reverse-proxy interno)
upstream mis_core_upstream {
    server 127.0.0.1:8080;
    keepalive 32;
}

server {
    listen 443 ssl http2;
    server_name hub.planta.local;

    ssl_certificate     /etc/letsencrypt/live/hub.planta.local/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hub.planta.local/privkey.pem;

    # ... outras apps do hub (cada uma em seu /<prefix>/ ou subdomínio) ...

    # ====================================================================
    # MIS Core — todo o tráfego /mis-core/* + /api/* (do MIS) entra aqui
    # ====================================================================

    # Frontend (SPA)
    location /mis-core/ {
        proxy_pass http://mis_core_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";

        # NUNCA cachear index.html no hub — o frontend já manda Cache-Control:
        # no-store. Mas o hub PODE estar com proxy_cache global; aqui forçamos
        # bypass para o /mis-core/ inteiro:
        proxy_cache off;
        proxy_buffering off;
    }

    # API Django sob /mis-core/api/  →  reescreve para /api/  no upstream
    location /mis-core/api/ {
        rewrite ^/mis-core/api/(.*)$ /api/$1 break;
        proxy_pass http://mis_core_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        # Repasse de Authorization para JWT
        proxy_set_header Authorization     $http_authorization;
        proxy_cache off;
        proxy_buffering off;
    }

    # FastAPI v2
    location /mis-core/api/v2/ {
        rewrite ^/mis-core/api/v2/(.*)$ /api/v2/$1 break;
        proxy_pass http://mis_core_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header Authorization     $http_authorization;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_read_timeout                 120s;
        proxy_cache off;
    }

    # Compatibilidade de bookmarks/rotas antigas: sem Flask.
    # Qualquer /flask-api/* antigo e reescrito para /api/* no MIS Core.
    location /mis-core/flask-api/ {
        rewrite ^/mis-core/flask-api/(.*)$ /api/$1 break;
        proxy_pass http://mis_core_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache off;
    }

    # Admin do Django
    location /mis-core-admin/ {
        proxy_pass http://mis_core_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        # Origin é exigido pelo Django para CSRF de POSTs do admin
        proxy_set_header Origin            $http_origin;
        proxy_cache off;
    }

    # Static do Django (admin v2 css)
    location /static/ {
        proxy_pass http://mis_core_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Esses sim podem ser cached (arquivos com hash)
        proxy_cache_valid 200 1d;
    }

    # Portainer do MIS Core. O frontend interno encaminha ao container, que
    # aplica sua autenticacao nativa. Preserve /mc-portainer (base-url).
    location = /mc-portainer {
        return 301 /mc-portainer/;
    }
    location /mc-portainer/ {
        proxy_pass http://mis_core_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        client_max_body_size 100m;
        proxy_read_timeout 300s;
        proxy_cache off;
        proxy_buffering off;
    }

    # ====================================================================
    # Notas:
    #   - Para deploy NO MESMO HOST que outras apps, mantenha o prefixo
    #     /mis-core/ em TODOS os paths acima e ajuste no .env do MIS:
    #         FORCE_SCRIPT_NAME=/mis-core
    #         VITE_DJANGO_API_URL=/mis-core/api
    #         VITE_FLASK_API_URL=/mis-core/api
    #         VITE_FASTAPI_V2_URL=/mis-core/api/v2
    #         CSRF_TRUSTED_ORIGINS=https://hub.planta.local
    #         CORS_ALLOWED_ORIGINS=https://hub.planta.local
    #
    #   - Para deploy SOZINHO no host (subdomínio dedicado):
    #         server_name mis.planta.local;
    #         location / { ... }     # sem prefixo
    #         (deixar VITE_*_URL nos defaults /api, /api, /api/v2)
    # ====================================================================
}
