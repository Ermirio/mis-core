# =============================================================================
# .env.example — MIS Core OFFLINE (servidor OT)
#
# Uso:
#   cp .env.example .env
#   nano .env   # preencher os campos marcados com TROQUE
#
# CAMPOS OBRIGATÓRIOS (sem default seguro — o compose recusa subir sem):
#   MIS_VERSION
#   DJANGO_SECRET_KEY  JWT_SECRET_KEY
#   MYSQL_PASSWORD     MYSQL_ROOT_PASSWORD
#   INFLUXDB_PASSWORD
#   DJANGO_SUPERUSER_PASSWORD
#   CSRF_TRUSTED_ORIGINS  CORS_ALLOWED_ORIGINS
# =============================================================================

# ---------------------------------------------------------------------------
# VERSÃO DAS IMAGENS — OBRIGATÓRIO
# ---------------------------------------------------------------------------
# Tem que bater EXATAMENTE com o tag das imagens importadas.
# Confira após `bash scripts/install.sh` rodar:
#   docker images mis-core-frontend
#
# Conferência rápida pós-up:
#   curl http://localhost:8080/version.json
#   curl http://localhost:8001/api/version/
MIS_VERSION=dev

TZ=America/Sao_Paulo

# ===========================================================================
# MODO DE OPERAÇÃO — production | demo
# ===========================================================================
# production : coletor conecta no OPC UA real (comportamento padrão)
# demo       : NÃO conecta em OPC real. O coletor gera dados sintéticos
#              correlacionados (linha/estados/OEE/descarte/CUC) e o Django
#              executa seed_demo automaticamente. Frontend mostra banner
#              amarelo "MODO DEMONSTRAÇÃO".
#
# Para alternar entre produção e demonstração, edite este campo e reinicie:
#   docker compose down && docker compose up -d
# As imagens são as MESMAS — só o comportamento muda via env.
#
# IMPORTANTE: O sistema NUNCA apaga dados automaticamente. Mesmo alternando
# de demo para production, a Fábrica DEMO e o histórico simulado FICAM no
# banco. Para limpar manualmente (com backup SQL antes):
#
#   docker compose exec django python manage.py clean_demo --dry-run   # só lista
#   docker compose exec django python manage.py clean_demo --backup    # backup+apaga
#
# Rollback do backup: o dump fica em /app/backups/pre_clean_demo_<ts>.sql
# dentro do container; copie pra fora com `docker compose cp` e restaure com
# `mysql -u... -p... mis_core_db < dump.sql`.
MIS_MODE=production

# Quantos dias de histórico pré-popular no InfluxDB (apenas em MIS_MODE=demo).
# Roda uma única vez (marker `demo_marker` evita duplicar em restart).
DEMO_BACKFILL_DIAS=7
DEMO_BACKFILL_STEP_S=60

# ===========================================================================
# ABERTURA DE ORIGENS — toggle único que vale para Django e FastAPI
# ===========================================================================
# ALLOW_ANY_ORIGIN=True:
#   - ALLOWED_HOSTS = ['*'] no Django
#   - CSRF_TRUSTED_ORIGINS wildcard
#   - CORS aberto em Django e FastAPI
#   - CSRF exempt nas rotas /api/*, /flask-api/*, /api/v2/* (admin segue protegido)
# Use quando o IP do cliente varia (VPN/Tailscale) ou quando uma máquina
# intermediária faz proxy reverso para o MIS Core. JAMAIS em internet aberta.
#
# ALLOW_ANY_ORIGIN=False:
#   - Respeita as listas DJANGO_ALLOWED_HOSTS / CSRF_TRUSTED_ORIGINS /
#     CORS_ALLOWED_ORIGINS abaixo. Use em rede OT fechada com IP fixo.
ALLOW_ANY_ORIGIN=True

# ---------------------------------------------------------------------------
# REDE — IP/PORTA do servidor OT
# ---------------------------------------------------------------------------
# Servidor OT alvo: http://192.168.70.160:8080
# Qualquer cliente na rede 192.168.70.0/24 deve acessar por este IP.
SERVER_HOST=192.168.70.160
FRONTEND_PORT=8080
# Porta direta do Django (útil para diagnóstico, opcional)
DJANGO_PORT=8001
FASTAPI_PORT=8002
MYSQL_EXPOSED_PORT=3308
INFLUXDB_EXPOSED_PORT=8087
CHRONOGRAF_PORT=8889
# Portas dos novos serviços
GRAFANA_PORT=3001
NODE_RED_PORT=1880
EMQX_MQTT_PORT=1883
EMQX_WS_PORT=8083
EMQX_DASHBOARD_PORT=18083

# ---------------------------------------------------------------------------
# DJANGO
# ---------------------------------------------------------------------------
# Gere chaves aleatórias com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=TROQUE-POR-CHAVE-LONGA-E-ALEATORIA
JWT_SECRET_KEY=TROQUE-POR-CHAVE-LONGA-E-ALEATORIA-DIFERENTE-DA-DE-CIMA

DJANGO_DEBUG=False

# IPs/hostnames da rede OT que vão acessar — separados por vírgula.
# IMPORTANTE: Inclua SEMPRE os nomes internos dos containers (django, fastapi, etc.)
# pois o coletor e os backends se comunicam internamente com Host: django:8000
# e o Django rejeita com 400 se o hostname não estiver nesta lista.
DJANGO_ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://192.168.70.160:8080,http://localhost:8080,http://127.0.0.1:8080
CORS_ALLOWED_ORIGINS=http://192.168.70.160:8080,http://localhost:8080,http://127.0.0.1:8080
# Quando ALLOW_ANY_HOST=True (acima), os três acima são IGNORADOS — qualquer IP passa.

# Superusuário criado automaticamente
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@mis.local
DJANGO_SUPERUSER_PASSWORD=TROQUE-POR-SENHA-FORTE

# Domínio dos cookies (deixar vazio em IP fixo; preencher se hub usa subdomínio)
SESSION_COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# SUB-PATH (deploy atrás de hub proxy)
# ---------------------------------------------------------------------------
# Se o hub serve em https://hub/mis-core/  →  preencha:
#     FORCE_SCRIPT_NAME=/mis-core
# Se serve em https://hub/   (root)         →  deixe vazio:
FORCE_SCRIPT_NAME=

# ---------------------------------------------------------------------------
# URLs de API que o frontend usa em runtime
# (não rebuilda a imagem; só sobrescreve via window.ENV)
# ---------------------------------------------------------------------------
# Standalone (default funciona):
VITE_DJANGO_API_URL=/api
VITE_FLASK_API_URL=/api
VITE_FASTAPI_V2_URL=/api/v2

# Atrás de hub que mapeia /mis-core/api/, troque para:
# VITE_DJANGO_API_URL=/mis-core/api
# VITE_FLASK_API_URL=/mis-core/api
# VITE_FASTAPI_V2_URL=/mis-core/api/v2

# ---------------------------------------------------------------------------
# MYSQL
# ---------------------------------------------------------------------------
MYSQL_PORT=3306
MYSQL_DATABASE=mis_core_db
MYSQL_USER=mis
MYSQL_PASSWORD=TROQUE-POR-SENHA-FORTE
MYSQL_ROOT_PASSWORD=TROQUE-POR-SENHA-ROOT-FORTE

# ---------------------------------------------------------------------------
# INFLUXDB
# ---------------------------------------------------------------------------
INFLUXDB_PORT=8086
INFLUXDB_DATABASE=industrial_db
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=TROQUE-POR-SENHA-FORTE

# ---------------------------------------------------------------------------
# FASTAPI v2
# ---------------------------------------------------------------------------
FASTAPI_LOG_LEVEL=INFO
# IMPORTANTE: lista separada por virgula; evita erro de parse no Docker Compose/Pydantic.
FASTAPI_CORS_ORIGINS=*
MAX_POINTS_PER_RESPONSE=10000

# ---------------------------------------------------------------------------
# GRAFANA / NODE-RED / EMQX (credenciais admin)
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123
GRAFANA_ANON_ACCESS=false
EMQX_ADMIN_USER=admin
EMQX_ADMIN_PASSWORD=public
MAX_CORRELATION_VARIABLES=25
PROMETHEUS_ENABLED=true

# Senha inicial do administrador nativo do Portainer. Os scripts geram uma
# senha aleatoria quando este placeholder ainda estiver presente. Depois que
# a conta for criada, alteracoes de senha sao feitas no proprio Portainer.
PORTAINER_ADMIN_PASSWORD=TROQUE-POR-SENHA-FORTE-PORTAINER

# ---------------------------------------------------------------------------
# COLETOR OPC UA
# ---------------------------------------------------------------------------
INTERVALO_COLETA=2
TIMEOUT_REQUEST=10
