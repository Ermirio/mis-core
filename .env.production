# ==========================================
# CONFIGURAÇÃO GERAL (DOCKER COMPOSE)
# ==========================================
# Portas expostas no Host (AJUSTADAS PARA PRODUÇÃO)
FLASK_PORT=5005
DJANGO_PORT=8001
REACT_PORT=3004
CHRONOGRAF_PORT=8888  # Interface web do InfluxDB

# ==========================================
# CONFIGURAÇÃO DE BANCO DE DADOS (INFLUXDB)
# ==========================================
# IMPORTANTE: Escolha uma das opções abaixo (Interno ou Externo)

# OPÇÃO 1: InfluxDB INTERNO (Recomendado para Deploy Completo)
# O Docker Compose irá criar e gerenciar o container do InfluxDB.
INFLUXDB_HOST=influxdb
INFLUXDB_PORT=8086
INFLUXDB_PORT_INTERNAL=8086

# OPÇÃO 2: InfluxDB EXTERNO (Se já tiver instalado na máquina)
# INFLUXDB_HOST=host.docker.internal
# INFLUXDB_PORT=8086
# INFLUXDB_PORT_INTERNAL=8086

# Configurações comuns
INFLUXDB_DATABASE=industrial_db
INFLUXDB_USER=admin
INFLUXDB_USER_PASSWORD=admin123

# ==========================================
# CONFIGURAÇÃO BACKEND (FLASK)
# ==========================================
# URL interna do Django (dentro da rede Docker)
DJANGO_API_URL=http://backend-django:8000/api

# ==========================================
# CONFIGURAÇÃO BACKEND (DJANGO)
# ==========================================
SECRET_KEY=django-insecure-MUDE-ESTA-CHAVE-EM-PRODUCAO
DEBUG=False
ALLOWED_HOSTS=*

# ==========================================
# CONFIGURAÇÃO DE BANCO DE DADOS (MYSQL)
# ==========================================
# IMPORTANTE: Escolha uma das opções abaixo (Interno ou Externo)

# OPÇÃO 1: MySQL INTERNO (Recomendado para Deploy Completo)
# O Docker Compose irá criar e gerenciar o container do MySQL.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_PORT_INTERNAL=3306

# OPÇÃO 2: MySQL EXTERNO (Se já tiver instalado na máquina)
# MYSQL_HOST=host.docker.internal
# MYSQL_PORT=3306
# MYSQL_PORT_INTERNAL=3306

# Configurações comuns
MYSQL_DB=industrial_db
MYSQL_USER=root
MYSQL_PASSWORD=sua_senha_mysql_aqui

# ==========================================
# CONFIGURAÇÃO FRONTEND (REACT)
# ==========================================
# URLs acessíveis pelo navegador do usuário
# IMPORTANTE: Ajuste o IP conforme a máquina de produção (ex: 192.168.1.100)
# Não use 'localhost' se for acessar de outros computadores.
VITE_API_BASE_URL=http://localhost:5005
VITE_DJANGO_API_URL=http://localhost:8001/api
VITE_FLASK_API_URL=http://localhost:5005/api

# Variáveis de UI e Analytics
VITE_APP_TITLE=Monitoramento Industrial
VITE_APP_LOGO=/favicon.ico
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# ==========================================
# CONFIGURAÇÃO COLETOR OPC UA
# ==========================================
# URLs internas (Docker Network) - O Coletor roda dentro do Docker
COLETOR_DJANGO_API_URL=http://backend-django:8000/api
COLETOR_FLASK_API_URL=http://backend-flask:5000/api
INTERVALO_COLETA=2
TIMEOUT_REQUEST=10

# Configurações do Servidor OPC UA
# IMPORTANTE: Ajuste conforme seu servidor OPC UA
# Se o OPC UA estiver no Host, use host.docker.internal
OPC_SERVER_URL=opc.tcp://host.docker.internal:4840
OPC_USERNAME=
OPC_PASSWORD=
